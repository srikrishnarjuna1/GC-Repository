
pipeline {
    agent any

    environment {
        APP_NAME = 'hello-world-jenkins-cicd'
        APP_VERSION = '1.0'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Fetching source code from GitHub'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Starting application build'

                sh '''
                    chmod +x app.txt
                    bash -n app.txt
                    echo "Build completed successfully"
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Starting application testing'

                sh '''
                    grep -q "HELLO WORLD APPLICATION" app.txt
                    grep -q "Welcome to Jenkins CI/CD Project" app.txt
                    echo "All tests passed"
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application'

                sh '''
                    mkdir -p deployment
                    cp app.txt deployment/
                    chmod +x deployment/app.txt

                    echo "Deployment completed"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Running deployed application'

                sh '''
                    ./deployment/app.txt
                '''
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Jenkins CI/CD completed!'
        }

        failure {
            echo 'FAILURE: Jenkins CI/CD failed!'
        }

        always {
            echo 'Pipeline execution completed'
        }
    }
}
